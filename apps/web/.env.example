# Copy to .env.local. `pnpm bootstrap:testnet` fills every PLIMSOLL_* and DEMO_* value for you.

# Postgres. Leave unset in development: `pnpm dev` serves an embedded PGlite on 127.0.0.1:54339 with data in <repo>/.data.
# DATABASE_URL=postgres://user:pass@host:5432/plimsoll
# Optional PEM root CA for verified TLS to Postgres (Supabase: "Supabase Root 2021 CA"). Leave sslmode out of the URL when set.
# DATABASE_CA_CERT=

# Public origin; WebAuthn passkeys are bound to its hostname.
PLIMSOLL_ORIGIN=http://localhost:3000

# testnet | local. Mainnet is refused by bootstrap and demo custody is disabled there.
STELLAR_NETWORK=testnet
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Relayer: sponsors fees and deploys escrows. Holds no authority over escrow funds.
PLIMSOLL_RELAYER_SECRET=
# Escrow wasm uploaded by bootstrap.
PLIMSOLL_ESCROW_WASM_HASH=

# Settlement asset. On testnet bootstrap issues DEMOUSD (demo token, not USDC).
PLIMSOLL_ASSET_CODE=DEMOUSD
PLIMSOLL_ASSET_ISSUER=
PLIMSOLL_TOKEN_CONTRACT_ID=
PLIMSOLL_ASSET_IS_DEMO=true
# Demo token issuer, used only by the testnet faucet.
PLIMSOLL_ISSUER_SECRET=

# Testnet-only custodial keys for the five seeded demo personas.
DEMO_BUYER_SECRET=
DEMO_SUPPLIER_SECRET=
DEMO_INSPECTOR_SECRET=
DEMO_FORWARDER_SECRET=
DEMO_RESOLVER_SECRET=

# Optional: plain-language explanations of rule findings, and model-assisted extraction for scans
# and documents the rules cannot read (fills only fields the rules missed, labelled for review,
# confidence capped at 0.85). Severity always comes from the rules.
# ANTHROPIC_API_KEY=
# PLIMSOLL_MODEL=claude-opus-5-5

# Content-addressed document store (swap for S3 + object lock in production).
OBJECT_STORE_DIR=.data/objects
# Production: OBJECT_STORE=s3 with any S3-compatible bucket (Supabase Storage, Cloudflare R2).
# OBJECT_STORE=s3
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_BUCKET=plimsoll-originals
# S3_REGION=eu-west-1
# Supabase session auth: access key = project ref, secret = anon key, session token = service-role key.
# R2 or plain S3 keys: set the first two and leave the token unset.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# Serverless hosts: RUN_WORKERS=false and a scheduler calling POST /api/internal/tick with this bearer secret.
# CRON_SECRET=
# Set false on web nodes when running a separate worker process.
RUN_WORKERS=true

# Outgoing email: verification links, deal and organization invitations, deal notifications.
# log (default) prints each message to the server console; in production builds it prints only
# the recipient and subject, because bodies carry single-use links.
# cloudflare sends through Cloudflare Email Service (REST API). EMAIL_FROM must be on a domain
# onboarded under Email Service > Email Sending in the same Cloudflare account.
EMAIL_TRANSPORT=log
# EMAIL_FROM=notifications@yourdomain.com
# EMAIL_FROM_NAME=Plimsoll
# CLOUDFLARE_ACCOUNT_ID=
# Account API token with the "Email Sending: Edit" permission.
# CLOUDFLARE_EMAIL_API_TOKEN=
